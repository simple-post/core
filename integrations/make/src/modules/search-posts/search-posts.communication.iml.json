{
	"url": "/api/v1/posts",
	"method": "GET",
	"qs": {
		"type": "{{parameters.status}}",
		"page": 1,
		"limit": 100
	},
	"response": {
		"iterate": "{{body.posts}}",
		"output": {
			"{{...}}": "{{omit(item, 'scheduledFor', 'publishedAt', 'createdAt', 'repostDueAt', 'repostedAt')}}",
			"scheduledFor": "{{if(item.scheduledFor, parseDate(item.scheduledFor, if(contains(item.scheduledFor, '.'), 'YYYY-MM-DDTHH:mm:ss.SSSZ', 'YYYY-MM-DDTHH:mm:ssZ')), item.scheduledFor)}}",
			"publishedAt": "{{if(item.publishedAt, parseDate(item.publishedAt, if(contains(item.publishedAt, '.'), 'YYYY-MM-DDTHH:mm:ss.SSSZ', 'YYYY-MM-DDTHH:mm:ssZ')), item.publishedAt)}}",
			"createdAt": "{{if(item.createdAt, parseDate(item.createdAt, if(contains(item.createdAt, '.'), 'YYYY-MM-DDTHH:mm:ss.SSSZ', 'YYYY-MM-DDTHH:mm:ssZ')), item.createdAt)}}",
			"repostDueAt": "{{if(item.repostDueAt, parseDate(item.repostDueAt, if(contains(item.repostDueAt, '.'), 'YYYY-MM-DDTHH:mm:ss.SSSZ', 'YYYY-MM-DDTHH:mm:ssZ')), item.repostDueAt)}}",
			"repostedAt": "{{if(item.repostedAt, parseDate(item.repostedAt, if(contains(item.repostedAt, '.'), 'YYYY-MM-DDTHH:mm:ss.SSSZ', 'YYYY-MM-DDTHH:mm:ssZ')), item.repostedAt)}}"
		},
		"limit": "{{parameters.limit}}"
	},
	"pagination": {
		"qs": {
			"page": "{{pagination.page}}"
		},
		"condition": "{{body.pagination.hasNextPage}}"
	}
}
