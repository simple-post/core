{
	"condition": "{{body.event = 'post.published'}}",
	"output": {
		"{{...}}": "{{omit(body, 'createdAt', 'post')}}",
		"createdAt": "{{if(body.createdAt, parseDate(body.createdAt, if(contains(body.createdAt, '.'), 'YYYY-MM-DDTHH:mm:ss.SSSZ', 'YYYY-MM-DDTHH:mm:ssZ')), body.createdAt)}}",
		"post": {
			"{{...}}": "{{omit(body.post, 'publishedAt')}}",
			"publishedAt": "{{if(body.post.publishedAt, parseDate(body.post.publishedAt, if(contains(body.post.publishedAt, '.'), 'YYYY-MM-DDTHH:mm:ss.SSSZ', 'YYYY-MM-DDTHH:mm:ssZ')), body.post.publishedAt)}}"
		}
	}
}
