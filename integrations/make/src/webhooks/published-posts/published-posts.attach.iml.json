{
	"url": "/api/v1/webhooks",
	"method": "POST",
	"body": {
		"url": "{{webhook.url}}",
		"events": [
			"post.published"
		]
	},
	"response": {
		"data": {
			"externalHookId": "{{body.webhook.id}}"
		}
	},
	"log": {
		"sanitize": [
			"request.headers.authorization",
			"request.body.url",
			"response.body.webhook.secret",
			"response.body.webhook.url"
		]
	}
}
