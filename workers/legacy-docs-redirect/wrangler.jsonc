{
  "name": "simplepost-docs-redirect",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "docs.simplepost.dev/*", "zone_name": "simplepost.dev" }],
  "observability": { "enabled": true, "logs": { "enabled": true, "head_sampling_rate": 1 } },
}
