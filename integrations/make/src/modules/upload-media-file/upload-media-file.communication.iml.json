{
	"url": "/api/v1/upload",
	"method": "POST",
	"type": "multipart/form-data",
	"body": {
		"file": {
			"value": "{{parameters.data}}",
			"options": {
				"filename": "{{parameters.fileName}}",
				"contentType": "{{mime(parameters.fileName)}}"
			}
		}
	},
	"response": {
		"output": {
			"id": "{{body.key}}",
			"url": "{{body.url}}",
			"type": "{{if(contains(body.type, 'video/'), 'video', 'image')}}",
			"contentType": "{{body.type}}",
			"filename": "{{body.filename}}",
			"size": "{{body.size}}"
		}
	}
}
