{
	"url": "/api/v1/posts",
	"method": "GET",
	"qs": {
		"type": "{{switch(parameters.type, 'drafts', 'drafts', 'past', 'past', 'failed', 'failed', 'scheduled')}}",
		"page": 1,
		"limit": 100
	},
	"response": {
		"limit": 300,
		"iterate": "{{body.posts}}",
		"output": {
			"label": "[{{capitalize(item.status)}}] {{substring(ifempty(item.message, item.id), 0, 70)}} ({{item.id}})",
			"value": "{{item.id}}"
		}
	},
	"pagination": {
		"qs": {
			"page": "{{pagination.page}}"
		},
		"condition": "{{body.pagination.hasNextPage && pagination.page <= 3}}"
	}
}
